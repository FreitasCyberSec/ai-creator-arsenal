{
  "name": "Turn one video into native TikTok, Instagram and YouTube posts with PostWire",
  "nodes": [
    {
      "parameters": {},
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "When you click Test workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-260, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "idea",
              "value": "Describe your approved video and intended post angle here.",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "video_url",
              "value": "https://example.com/your-vertical-video.mp4",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "platforms",
              "value": "={{ [\"tiktok\", \"instagram\", \"youtube\"] }}",
              "type": "array"
            },
            {
              "id": "f4",
              "name": "brand_voice",
              "value": "Natural, concise, platform-native, no spammy repetition.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Your idea, video and platforms",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://postwire.io/api/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.idea, platforms: $json.platforms, media_url: $json.video_url, brand_voice: $json.brand_voice }) }}",
        "options": {}
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Write a native caption per platform",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://postwire.io/api/post",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platforms: $('Your idea, video and platforms').item.json.platforms, video_url: $('Your idea, video and platforms').item.json.video_url, per_platform: $json.drafts, options: { tiktok: { privacy_level: 'SELF_ONLY' } } }) }}",
        "options": {}
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "Publish to every connected account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    }
  ],
  "connections": {
    "When you click Test workflow": {
      "main": [[{ "node": "Your idea, video and platforms", "type": "main", "index": 0 }]]
    },
    "Your idea, video and platforms": {
      "main": [[{ "node": "Write a native caption per platform", "type": "main", "index": 0 }]]
    },
    "Write a native caption per platform": {
      "main": [[{ "node": "Publish to every connected account", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
